{
  "private": true,
  "packageManager": "pnpm@8.6.10",
  "scripts": {
    "build": "vite build",
    "dev": "vite --port 3333 --open",
    "lint": "eslint src test vite.config.ts uno.config.ts capacitor.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "up": "taze major -I",
    "test:run": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@vueuse/core": "^15.0.0",
    "vue": "^3.5.45",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.5",
    "@iconify-json/carbon": "^1.1.17",
    "@iconify-json/ph": "^1.1.12",
    "@iconify-json/simple-icons": "^1.1.87",
    "@types/node": "^24.0.0",
    "@unocss/eslint-config": "^0.53.0",
    "@unocss/reset": "^66.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^8.42.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^13.2.2",
    "pnpm": "^8.6.0",
    "taze": "^0.10.2",
    "typescript": "^5.9.0",
    "unocss": "^66.13.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vite-plugin-pages": "^0.33.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "@capacitor/cli": "^8.5.3"
  },
  "eslintConfig": {
    "extends": [
      "@antfu",
      "@unocss"
    ]
  }
}
