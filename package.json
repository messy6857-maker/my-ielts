{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "vite build",
    "build:android": "vite build --mode android",
    "dev": "vite --port 3333 --open",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
