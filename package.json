    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@capacitor/cli": "^8.5.3",
    "@iconify-json/carbon": "^1.1.17",
    "@iconify-json/ph": "^1.1.12",
    "@iconify-json/simple-icons": "^1.1.87",
    "@types/node": "^24.19.2",
    "@unocss/eslint-config": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "unocss": "^66.11.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
